# --- Raspberry Pi .env ---
# Copy to .env and adjust values.

# Node identity
ACIES_NAMESPACE=rs1

# Zenoh — connect to edge
ZENOH_BRIDGE=tcp/<LAPTOP_IP>:7500
ZENOH_CONNECT=tcp/127.0.0.1:7501

# Classifier
MODEL_DIR=/model
VFM_WEIGHT=Parkland_TransformerV4_vehicle_classification_finetune_ict2024_1.0_multiclass_best.pt
VFM_LABELS=gle350,miata,cx30,mustang
# Split VibroFM: shared encoder (acies-vfm-encoder) + task head (acies-vfm-head); reuse MODEL_DIR.
# Encoder output dim must match the head (single-modality encoder = 256).
VFM_ENCODER_WEIGHT=WestPoint_encoder.pt
VFM_HEAD_WEIGHT=WestPoint_class_layer.pt
# ACIES_LOG=acies.core=DEBUG

# Replay (scenario 3 — tabletop demo, uncomment)
# SCENE=2024-03-29-ICT
# RUN=2
# NODE=rs1
