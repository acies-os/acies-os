# --- Edge .env ---
# Copy to .env and adjust values.
PI_HOSTS="rs1 rs2 rs3 rs7 rs8 rs10"

# Zenoh
ZENOH_CONNECT=tcp/127.0.0.1:7501
ZENOH_LISTEN=tcp/0.0.0.0:7500

# Gateway
ACIES_CONFIG=ict.toml
ACIES_LISTEN=ws://127.0.0.1:8765
# ACIES_LOG=acies.core=DEBUG
# ACIES_GATEWAY_DEBUG=1

# MQTT GPS bridge (live GPS over MQTT; enable with --profile live)
MQTT_BROKER=192.168.70.51
MQTT_PORT=1883
MQTT_TOPIC="/+/gps"

# UI
UI_PORT=5173

# Replay (scenario 2 & 3)
SCENE=2024-03-29-ICT
RUN=2
GPS_LABEL=miata
DATA_DIR=/data/replay

# Node name overrides for GCQ (uncomment as needed)
# NODE_RS1=gq-1
# NODE_RS3=gq-2
# NODE_RS8=gq-3
# NODE_RS10=gq-4

# Classifier (scenario 2)
MODEL_DIR=/model
VFM_WEIGHT=Parkland_TransformerV4_vehicle_classification_finetune_ict2024_1.0_multiclass_best.pt
VFM_LABELS=gle350,miata,cx30,mustang

# SPAR Classifier and Tracker. Reuses VFM_LABELS and MODEL_DIR.
SPAR_WEIGHT=demo2-2024-03-29-ICT_MAEBackbone_vehicle_classification_1.0_finetune_latest.pt
SPAR_TRACKING_WEIGHT=demo2-2024-03-29-ICT_MAEBackbone_vehicle_tracking_1.0_finetune_latest.pt