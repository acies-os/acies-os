# --- Edge .env ---
# Copy to .env and adjust values.
PI_HOSTS="rs1 rs2 rs3 rs7 rs8 rs10"

# Zenoh
ZENOH_CONNECT=tcp/127.0.0.1:7501
ZENOH_LISTEN=tcp/0.0.0.0:7500

# Gateway
ACIES_CONFIG=ict.toml
ACIES_LISTEN=ws://127.0.0.1:8765
# ACIES_LOG=acies.core=DEBUG
# ACIES_GATEWAY_DEBUG=1

# MQTT GPS bridge (live GPS over MQTT; enable with --profile live)
MQTT_BROKER=192.168.70.51
MQTT_PORT=1883
MQTT_TOPIC="/+/gps"

# UI
UI_PORT=5173

# Replay (scenario 2 & 3)
SCENE=2024-03-29-ICT
RUN=2
GPS_LABEL=miata
DATA_DIR=/data/replay
# Drone audio replay (8 kHz upsampled to 16 kHz, <ns>/drone_mic on every node; starts deactivated)
DRONE_SCENE=audrok
DRONE_RUN=1

# Node name overrides for GCQ (uncomment as needed)
# NODE_RS1=gq-1
# NODE_RS3=gq-2
# NODE_RS8=gq-3
# NODE_RS10=gq-4

# Classifier (scenario 2)
MODEL_DIR=/model
VFM_WEIGHT=Parkland_TransformerV4_vehicle_classification_finetune_ict2024_1.0_multiclass_best.pt
VFM_LABELS=gle350,miata,cx30,mustang
# Split VibroFM: one shared encoder (acies-vfm-encoder) + two task heads (acies-vfm-head); reuse MODEL_DIR.
# The encoder must include audio weights; it embeds geo+mic for vehicles and drone_mic (audio only) for drones.
# Head embed dims: vehicle = 512 (seismic + audio), drone = 256 (audio).
VFM_ENCODER_WEIGHT=Parkland_ict2024_encoder.pt
VFM_VEHICLE_HEAD_WEIGHT=Parkland_ict2024_class_layer.pt
# VFM_VEHICLE_HEAD_WEIGHT=Parkland_wp2026_class_layer.pt
VFM_DRONE_HEAD_WEIGHT=AuDroK_class_layer.pt
# VFM_VEHICLE_EMBED_DIM=512
# VFM_DRONE_EMBED_DIM=256
# Must match the drone head's class order (placeholder: alphabetical AuDroK class names).
VFM_DRONE_LABELS=cartonic_toy_drone,dji_avata,dji_inspire_2,dji_matrice_300,dji_matrice_30_t,dji_mavic_3e,dji_mini_3,dji_phantom_4,emotion,hp_e616p_1,hpx4,mavic_air_2,potensic_firefly

# SPAR weights; reuse MODEL_DIR
SPAR_WEIGHT=spar_2024-03-29-ICT.pt
SPAR_LABELS=gle350,miata,cx30,mustang
